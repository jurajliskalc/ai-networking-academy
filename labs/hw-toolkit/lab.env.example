# AI Networking Academy lab profile. Generate your own on the academy's Connect page (Real HW labs ->
# Connect), save it as labs/hw-toolkit/lab.env on every host, or copy this file and edit it.
# Bash syntax: it is sourced by every lab script.
LAB_NAME=my-lab
FABRIC=roce                 # roce | ib
SSH_USER=                   # user host A uses to reach B and C (empty = current user / ~/.ssh/config)
AINA_DIR=~/ai-networking-academy
HOST_COUNT=2                # 2 | 3

HOST_A=node-a
HOST_B=node-b
HOST_C=node-c
A_IP=192.168.50.11
B_IP=192.168.50.12
C_IP=192.168.50.13
PREFIX_LEN=24
A_NETDEV=ens1f0np0
B_NETDEV=ens1f0np0
C_NETDEV=ens1f0np0
A_RDMA_DEV=mlx5_0
B_RDMA_DEV=mlx5_0
C_RDMA_DEV=mlx5_0
RDMA_PORT=1

MTU=9000
GID_INDEX=3
ROCE_PRIO=3
ROCE_DSCP=26
CNP_DSCP=48
TCLASS=106                  # ROCE_DSCP * 4 + 2 (ECT(0)); lib.sh recomputes it

SWITCH=leaf1
SWITCH_OS=none              # none | cumulus | sonic | other
SWITCH_MGMT=10.0.0.2
A_SWITCH_PORT=swp1
B_SWITCH_PORT=swp2
C_SWITCH_PORT=swp3

GPUS_PER_NODE=1
GPU_INDEX=0
NCCL_TESTS_DIR=~/nccl-tests/build
