# shellcheck shell=bash
# hw-12-ib-partitions: the three lab partitions and the IPoIB subnets used on their child interfaces.
# Sourced by gen-partitions.sh, pkey-children.sh and check.sh. Change PKEY_NET if 10.81.x.0/24 is in
# use on your hosts (host A gets .1, host B .2 in each subnet).
PKEY_NET=${PKEY_NET:-10.81}
# shellcheck disable=SC2034  # used by the scripts that source this file
# P_Key (full-member form) : name : membership of host A : membership of host B : third octet
PARTITIONS=(
  "0x8001:storage:full:full:1"
  "0x8002:compute:full:limited:2"
  "0x8003:isolated:limited:limited:3"
)
